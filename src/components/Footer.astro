---
const today = new Date();
---

<footer>
	<p>packrat &copy; {today.getFullYear()} - Do whatever you want with it.</p>
	<a href="https://github.com/0x1eo/packrat" target="_blank">GitHub</a>
</footer>
<style>
	footer {
		padding: 2em 1em;
		background: var(--bg-secondary);
		color: var(--text-secondary);
		text-align: center;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}
	footer p {
		margin: 0 0 0.5em;
	}
	footer a {
		color: var(--accent);
		text-decoration: none;
	}
	footer a:hover {
		text-decoration: underline;
	}
</style>
